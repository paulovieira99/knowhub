# Copie para .env e preencha com valores fortes:
#   cp .env.example .env
# ou gere automaticamente:
#   ./scripts/setup-env.sh

# PostgreSQL (usado pelo docker-compose)
POSTGRES_PASSWORD=changeme-use-a-strong-password

# JWT — gere com: openssl rand -hex 32
SECRET_KEY=changeme-use-openssl-rand-hex-32

# Porta exposta no host
PORT=3000

# Opcional — desenvolvimento local sem Docker
# DATABASE_URL=postgresql+asyncpg://knowhub:senha@localhost:5432/knowhub

# Opcional — restringir CORS em produção (vírgula para múltiplas origens)
# CORS_ORIGINS=http://localhost:3000
